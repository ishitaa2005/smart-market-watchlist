# Copy this file to .env and fill in real values. Never commit .env itself.

APP_NAME="Smart Market Watchlist API"
ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string (used once database layer is wired up)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/watchlist

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
