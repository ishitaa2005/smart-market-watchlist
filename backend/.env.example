# Copy this file to .env and fill in real values. Never commit .env itself.

APP_NAME="Smart Market Watchlist API"
ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string (psycopg3 driver).
# Replace YOUR_PASSWORD with your local Postgres password — never commit a real one.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/smart_market_watchlist

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
